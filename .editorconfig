root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# O caddy fmt usa tab
[Caddyfile]
indent_style = tab

# Código gerado pelo EF Core
[**/Migrations/*.cs]
generated_code = true

[*.cs]
# Organização
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace:warning

# Preferências de linguagem
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_prefer_braces = when_multiline:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
dotnet_style_readonly_field = true:warning
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
csharp_style_prefer_primary_constructors = true:suggestion

# Formatação
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_cast = false
csharp_space_after_keywords_in_control_flow_statements = true

# Nomes: campos privados em _camelCase, constantes em PascalCase
dotnet_naming_rule.campos_privados.symbols = campos_privados
dotnet_naming_rule.campos_privados.style = sublinhado_camel
dotnet_naming_rule.campos_privados.severity = warning
dotnet_naming_symbols.campos_privados.applicable_kinds = field
dotnet_naming_symbols.campos_privados.applicable_accessibilities = private
dotnet_naming_style.sublinhado_camel.capitalization = camel_case
dotnet_naming_style.sublinhado_camel.required_prefix = _

dotnet_naming_rule.constantes.symbols = constantes
dotnet_naming_rule.constantes.style = pascal
dotnet_naming_rule.constantes.severity = warning
dotnet_naming_symbols.constantes.applicable_kinds = field
dotnet_naming_symbols.constantes.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

# Estáticos somente leitura também em PascalCase
dotnet_naming_rule.estaticos_readonly.symbols = estaticos_readonly
dotnet_naming_rule.estaticos_readonly.style = pascal
dotnet_naming_rule.estaticos_readonly.severity = warning
dotnet_naming_symbols.estaticos_readonly.applicable_kinds = field
dotnet_naming_symbols.estaticos_readonly.required_modifiers = static, readonly
