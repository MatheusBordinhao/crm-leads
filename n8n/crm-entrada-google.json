    {
      "id": "98b33cad-df81-4875-ac30-e26eb802d787",
      "name": "Montar o lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 0],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Monta a entrada da seção 4.2 a partir do webhook do formulário de lead do Google Ads. Os ids vão como texto: o Google manda números.\nconst corpo = $json.body || {};\nfunction texto(valor) {\n  if (valor === undefined || valor === null || typeof valor === 'object') return null;\n  const limpo = String(valor).trim();\n  return limpo ? limpo : null;\n}\nfunction referencia(id) {\n  return texto(id) ? { id: texto(id), nome: null } : null;\n}\n\n// As colunas conhecidas vão para o lugar delas, pelo column_id; as outras, para as respostas extras, pelo nome da pergunta.\nconst conhecidas = ['FULL_NAME', 'FIRST_NAME', 'LAST_NAME', 'EMAIL', 'WORK_EMAIL', 'PHONE_NUMBER', 'WORK_PHONE', 'COMPANY_NAME', 'REGION'];\nconst colunas = {};\nconst respostasExtras = {};\nfor (const coluna of corpo.user_column_data || []) {\n  const valor = texto(coluna.string_value);\n  if (!valor) continue;\n  if (conhecidas.includes(coluna.column_id)) colunas[coluna.column_id] = valor;\n  else respostasExtras[coluna.column_name || coluna.column_id] = valor;\n}\nconst nome = colunas.FULL_NAME || [colunas.FIRST_NAME, colunas.LAST_NAME].filter(Boolean).join(' ') || null;\n\nreturn {\n  json: {\n    lead: {\n      origem: 'google_ads',\n      idExterno: texto(corpo.lead_id),\n      recebidoEm: $now.toUTC().toISO(),\n      teste: corpo.is_test === true || corpo.is_test === 'true',\n      nome: nome,\n      email: colunas.EMAIL || colunas.WORK_EMAIL || null,\n      telefone: colunas.PHONE_NUMBER || colunas.WORK_PHONE || null,\n      empresa: colunas.COMPANY_NAME || null,\n      uf: colunas.REGION || null,\n      plataforma: 'google',\n      campanha: referencia(corpo.campaign_id),\n      conjunto: referencia(corpo.adgroup_id),\n      anuncio: referencia(corpo.creative_id),\n      formulario: referencia(corpo.form_id),\n      gclid: texto(corpo.gcl_id),\n      respostasExtras: Object.keys(respostasExtras).length ? respostasExtras : null,\n    },\n  },\n};"
      }
    },
    {
      "id": "875a40b8-7606-42a2-810d-41ff6a906a53",
      "name": "Enviar ao CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [1120, 0],
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Configuração\").item.json.urlCrm }}/api/integracoes/leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.lead) }}",
        "options": { "timeout": 10000 }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "eMi2FrHkWd3bhcKD", "name": "CRM - Chave de integração" }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "cac4babf-671a-4658-8114-a11cf3b289ae",
      "name": "Classificar a falha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1344, 160],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Classifica a falha do envio ao CRM (seção 4.5). Guarda só o código ou o tipo da falha, nunca o corpo da resposta, que pode ter dados pessoais.\nconst erro = $json.error || {};\nconst mensagem = String(erro.message || '');\nconst prefixo = /^([0-9]{3}) - /.exec(mensagem);\nconst codigo = String(erro.httpCode || erro.status || erro.statusCode || (prefixo ? prefixo[1] : ''));\n\nlet ultimoErro;\nif (/^[0-9]{3}$/.test(codigo)) {\n  ultimoErro = 'HTTP ' + codigo;\n} else if (/timeout|timed out|ETIMEDOUT|ECONNABORTED/i.test(String(erro.code || '') + ' ' + mensagem)) {\n  ultimoErro = 'Tempo esgotado (10 s)';\n} else {\n  ultimoErro = 'Falha de conexão';\n}\n\n// Um 4xx que não é 408 nem 429 é definitivo: tentar de novo não resolve, e o admin precisa olhar.\nconst definitiva = /^4[0-9]{2}$/.test(codigo) && codigo !== '408' && codigo !== '429';\nreturn { json: { definitiva: definitiva, ultimoErro: ultimoErro, lead: $('Montar o lead').item.json.lead } };"
      }
    },
