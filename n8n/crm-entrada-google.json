    {
      "id": "a7291adf-5f9f-48a4-84bc-b095850e144e",
      "name": "Sobre o fluxo",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-32, -96],
      "parameters": {
        "content": "## CRM - Entrada Google\nRecebe o webhook do formulário de lead do Google Ads. Confere a chave pelo SHA-256 (a chave em si não fica no fluxo): errada, responde 403 e avisa o admin. Certa, responde 200 com {} ao Google e manda o lead ao CRM (seção 4.2), com o lead_id como id externo, a campanha pelo id e o is_test como teste. Se o CRM não responder, o lead vai para a Data Table `crm_entradas_pendentes`. O endereço do CRM e o hash da chave ficam no nó \"Configuração\".",
        "color": 7,
        "width": 1056,
        "height": 304
      }
    }
