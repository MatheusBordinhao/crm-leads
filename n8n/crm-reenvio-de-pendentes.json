      }
    },
    {
      "id": "b7c4c37c-1a92-43a8-84bc-d1da63de4fea",
      "name": "Configuração",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [224, 80],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
