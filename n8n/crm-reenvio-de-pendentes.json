    },
    {
      "id": "e33090dc-923c-4c48-9d6a-2d56c2a7580a",
      "name": "Sobre o fluxo",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-32, -16],
      "parameters": {
        "content": "## CRM - Reenvio de pendentes\nDe hora em hora, das 8h às 20h, de segunda a sexta, reenvia ao CRM as entradas da Data Table `crm_entradas_pendentes`, uma por segundo. Deu certo (inclusive \"já recebido\"): apaga a linha. Falhou: soma a tentativa e grava o erro, sem o corpo da resposta. Um 4xx definitivo avisa o admin pelo CRM - Erros, e a linha fica na tabela. O endereço do CRM fica no nó \"Configuração\".",
        "color": 7,
        "width": 832,
        "height": 224
      }
    }
