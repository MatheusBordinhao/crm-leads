{
  "id": "yDU0FZa2tXN851ru",
  "name": "CRM - Reenvio de pendentes",
  "nodes": [
    {
      "id": "6e4d2ee8-56ce-4832-a768-5bf75f1ae298",
      "name": "De hora em hora, nos dias úteis",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [0, 80],
      "parameters": {
