        "options": {}
      }
    },
    {
      "id": "840f8158-e4c3-4630-a430-bbcbdc8cb41b",
      "name": "Buscar os pendentes",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [448, 80],
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": { "__rl": true, "mode": "name", "value": "crm_entradas_pendentes" },
        "returnAll": true,
        "orderBy": true,
