        "orderByDirection": "ASC"
      }
    },
    {
      "id": "b9da65b7-8b63-43d2-8956-5d54d003cd4a",
      "name": "Reenviar ao CRM",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [672, 80],
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Configuração\").first().json.urlCrm }}/api/integracoes/leads",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{ $json.payload }}",
        "options": {
          "timeout": 10000,
          "batching": { "batch": { "batchSize": 1, "batchInterval": 1000 } }
        }
      },
      "credentials": {
        "httpHeaderAuth": { "id": "eMi2FrHkWd3bhcKD", "name": "CRM - Chave de integração" }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "93733647-6577-4020-a76d-72d3efc28fa5",
      "name": "Classificar a falha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 240],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Classifica a falha do reenvio (seção 4.5). Guarda só o código ou o tipo da falha, nunca o corpo da resposta, que pode ter dados pessoais.\nconst erro = $json.error || {};\nconst mensagem = String(erro.message || '');\nconst prefixo = /^([0-9]{3}) - /.exec(mensagem);\nconst codigo = String(erro.httpCode || erro.status || erro.statusCode || (prefixo ? prefixo[1] : ''));\n\nlet ultimoErro;\nif (/^[0-9]{3}$/.test(codigo)) {\n  ultimoErro = 'HTTP ' + codigo;\n} else if (/timeout|timed out|ETIMEDOUT|ECONNABORTED/i.test(String(erro.code || '') + ' ' + mensagem)) {\n  ultimoErro = 'Tempo esgotado (10 s)';\n} else {\n  ultimoErro = 'Falha de conexão';\n}\n\n// Um 4xx que não é 408 nem 429 é definitivo: a linha fica na tabela, e o admin precisa olhar.\nconst definitiva = /^4[0-9]{2}$/.test(codigo) && codigo !== '408' && codigo !== '429';\nconst linha = $('Buscar os pendentes').item.json;\nreturn { json: { id: linha.id, tentativas: (Number(linha.tentativas) || 0) + 1, ultimoErro: ultimoErro, definitiva: definitiva } };"
      }
    },
    {
      "id": "b3e1ac3f-4eb7-4a22-8689-2078d1f09b93",
      "name": "Atualizar a tentativa",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [1120, 240],
      "parameters": {
        "resource": "row",
        "operation": "update",
        "dataTableId": { "__rl": true, "mode": "name", "value": "crm_entradas_pendentes" },
        "matchType": "allConditions",
        "filters": {
          "conditions": [{ "keyName": "id", "condition": "eq", "keyValue": "={{ $json.id }}" }]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "tentativas": "={{ $json.tentativas }}",
            "ultimo_erro": "={{ $json.ultimoErro }}"
          },
          "schema": [
            {
              "id": "tentativas",
              "displayName": "tentativas",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": true
            },
            {
              "id": "ultimo_erro",
              "displayName": "ultimo_erro",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "3b5d679b-34ce-4e11-a005-832edc183ba8",
      "name": "Falha definitiva?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [1344, 240],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $(\"Classificar a falha\").item.json.definitiva }}",
              "rightValue": true,
              "operator": { "type": "boolean", "operation": "true", "singleValue": true }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "39d37783-680e-477f-aa75-394f24fdc94d",
      "name": "Avisar o admin",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [1568, 160],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "=O CRM recusou uma entrada da fila de pendentes ({{ $(\"Classificar a falha\").item.json.ultimoErro }}). Ela continua na Data Table crm_entradas_pendentes, com as tentativas e o último erro."
      }
    },
    {
      "id": "bf4516ba-eb93-4fc0-b694-70280c1eecd3",
      "name": "Apagar da fila",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
