    {
      "id": "2b5b1d15-165d-4eee-ba6e-9db6c21adc6f",
      "name": "Buscar campanha e plataforma",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [448, 80],
      "parameters": {
        "method": "GET",
        "url": "={{ $json.urlGraph }}/{{ $(\"Novo lead da Meta\").item.json.id }}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "facebookLeadAdsOAuth2Api",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [{ "name": "fields", "value": "campaign_id,campaign_name,platform" }]
        },
        "options": { "timeout": 10000 }
