    {
      "id": "7083fe90-1f49-4638-844c-72de67662f70",
      "name": "Classificar a falha",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1568, 240],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Classifica a falha do envio ao CRM (seção 4.5). Guarda só o código ou o tipo da falha, nunca o corpo da resposta, que pode ter dados pessoais.\n// A regra do destino é a mesma nos fluxos de entrada e no reenvio, e o FluxosN8nTests confere que o texto dela é igual nos quatro.\nfunction destinoDaFalha(codigo) {\n  // A recusa da própria entrada: tentar de novo não resolve, e ela vai para as recusadas.\n  if (codigo === '400' || codigo === '413') return 'recusada';\n  // O CRM fora do ar, lento ou no limite de requisições: o reenvio tenta de novo, sem e-mail.\n  if (codigo === '' || codigo === '408' || codigo === '429' || /^5[0-9]{2}$/.test(codigo)) return 'temporaria';\n  // A chave ou o endereço do CRM (401, 403, 404) e qualquer outro código: a entrada espera na fila, e o admin corrige.\n  return 'configuracao';\n}\n\nconst erro = $json.error || {};\nconst mensagem = String(erro.message || '');\nconst prefixo = /^([0-9]{3}) - /.exec(mensagem);\nconst bruto = String(erro.httpCode || erro.status || erro.statusCode || (prefixo ? prefixo[1] : ''));\nconst codigo = /^[0-9]{3}$/.test(bruto) ? bruto : '';\n\nlet ultimoErro;\nif (codigo) {\n  ultimoErro = 'HTTP ' + codigo;\n} else if (/timeout|timed out|ETIMEDOUT|ECONNABORTED/i.test(String(erro.code || '') + ' ' + mensagem)) {\n  ultimoErro = 'Tempo esgotado (10 s)';\n} else {\n  ultimoErro = 'Falha de conexão';\n}\n\n// Nas recusadas, o corpo vai inteiro só até 8 KB; acima disso, os primeiros 8 KB, e o detalhe guarda o tamanho original. Num 413,\n// vai sem o corpo. As Data Tables dividem um teto de 200 MiB, e o webhook do site é público.\nconst LIMITE_GUARDADO = 8 * 1024;\nconst lead = $('Montar o lead').item.json.lead;\nconst corpo = JSON.stringify(lead);\nconst tamanho = Buffer.byteLength(corpo, 'utf8');\nlet guardado = corpo;\nif (codigo === '413') {\n  guardado = '';\n} else if (tamanho > LIMITE_GUARDADO) {\n  guardado = Buffer.from(corpo, 'utf8').subarray(0, LIMITE_GUARDADO).toString('utf8').replace(/�$/, '');\n}\nconst cortado = guardado !== '' && guardado.length < corpo.length;\n\nreturn {\n  json: {\n    destino: destinoDaFalha(codigo),\n    ultimoErro: ultimoErro,\n    lead: lead,\n    payloadRecusada: guardado,\n    detalheRecusada: ultimoErro + ', entrada de ' + tamanho + ' bytes' + (cortado ? ', guardados os primeiros 8 KB' : ''),\n  },\n};"
      }
    },
