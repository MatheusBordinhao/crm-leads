    {
      "id": "2cc9d29c-d86d-4a70-9b9a-9df24129e85b",
      "name": "Conferir o tamanho",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 80],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Mede a entrada em bytes, como o CRM conta o limite do corpo: 64 KB (seção 4.2). Acima dele, a entrada nem vai ao CRM nem entra\n// na fila: fica nas recusadas, sem o corpo, só com o tamanho. O webhook do site é público, o n8n aceita corpos de até 16 MiB, e\n// as Data Tables dividem um teto de 200 MiB.\nconst LIMITE_DO_CRM = 64 * 1024;\nconst tamanho = Buffer.byteLength(JSON.stringify($json.lead), 'utf8');\nreturn { json: { ...$json, tamanho: tamanho, cabeNoCrm: tamanho <= LIMITE_DO_CRM } };"
      }
