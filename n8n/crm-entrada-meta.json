    {
      "id": "dbe5f37d-4e53-4512-86f0-17ddc7c9d727",
      "name": "Montar o lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [672, 80],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Monta a entrada da seção 4.2 a partir do gatilho da Meta (saída simplificada) e da consulta da campanha na Graph API.\n// O gatilho não traz a campanha nem a plataforma. Se a consulta falhar, o lead entra sem elas, e o fluxo avisa o admin no fim.\nconst gatilho = $('Novo lead da Meta').item.json;\nconst consulta = $json.error ? {} : $json;\nconst dados = gatilho.data || {};\nfunction texto(valor) {\n  if (valor === undefined || valor === null || typeof valor === 'object') return null;\n  const limpo = String(valor).trim();\n  return limpo ? limpo : null;\n}\nfunction referencia(objeto) {\n  return objeto && texto(objeto.id) ? { id: texto(objeto.id), nome: texto(objeto.name) } : null;\n}\n// A Meta manda a data como 2026-10-14T17:45:12+0000; o CRM espera ISO 8601 com o fuso no formato +00:00.\nfunction quando(valor) {\n  const data = new Date(String(valor || '').replace(/([+-][0-9]{2})([0-9]{2})$/, '$1:$2'));\n  return isNaN(data.getTime()) ? $now.toUTC().toISO() : data.toISOString();\n}\n\n// Os mesmos campos que a importação reconhece no CSV da Meta; os outros vão para as respostas extras.\nconst conhecidos = ['full_name', 'first_name', 'last_name', 'email', 'work_email', 'phone_number', 'work_phone_number', 'cpf', 'cnpj', 'cpf_cnpj', 'state', 'province', 'estado', 'uf', 'company_name', 'empresa'];\nconst respostasExtras = {};\nfor (const campo of Object.keys(dados)) {\n  if (!conhecidos.includes(campo) && texto(dados[campo])) respostasExtras[campo] = texto(dados[campo]);\n}\nconst nome = texto(dados.full_name) || [texto(dados.first_name), texto(dados.last_name)].filter(Boolean).join(' ') || null;\n// Os leads da Ferramenta de Teste de Anúncios de Cadastro chegam com os valores \"<test lead: dummy data for ...>\".\nconst teste = Object.values(dados).some(function (valor) { return typeof valor === 'string' && valor.indexOf('<test lead') === 0; });\nconst plataformas = { fb: 'facebook', ig: 'instagram', facebook: 'facebook', instagram: 'instagram' };\n\nreturn {\n  json: {\n    campanhaFaltou: Boolean($json.error),\n    lead: {\n      origem: 'meta_lead_ads',\n      idExterno: texto(gatilho.id),\n      recebidoEm: quando(gatilho.created_time),\n      teste: teste,\n      nome: nome,\n      email: texto(dados.email) || texto(dados.work_email),\n      telefone: texto(dados.phone_number) || texto(dados.work_phone_number),\n      cpfCnpj: texto(dados.cpf) || texto(dados.cnpj) || texto(dados.cpf_cnpj),\n      uf: texto(dados.state) || texto(dados.province) || texto(dados.estado) || texto(dados.uf),\n      empresa: texto(dados.company_name) || texto(dados.empresa),\n      plataforma: plataformas[String(consulta.platform || '').toLowerCase()] || null,\n      campanha: texto(consulta.campaign_id) ? { id: texto(consulta.campaign_id), nome: texto(consulta.campaign_name) } : null,\n      conjunto: referencia(gatilho.adset),\n      anuncio: referencia(gatilho.ad),\n      formulario: referencia(gatilho.form),\n      respostasExtras: Object.keys(respostasExtras).length ? respostasExtras : null,\n    },\n  },\n};"
      }
    },
    {
      "id": "79a4817e-043d-4d1e-ad9a-c018ffde95cc",
