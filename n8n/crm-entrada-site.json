    {
      "id": "5b893a8d-7e4d-4e3b-b44b-f21ffd9ca282",
      "name": "Montar o lead",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 160],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "// Monta a entrada da seção 4.2 a partir do formulário do site. O id externo é o UUID gerado neste envio, e o lead do site nunca é de teste.\nconst corpo = $json.body || {};\nfunction texto(valor) {\n  if (valor === undefined || valor === null || typeof valor === 'object') return null;\n  const limpo = String(valor).trim();\n  return limpo ? limpo : null;\n}\n\n// Os campos conhecidos vão para o lugar deles; a mensagem e os outros campos preenchidos, para as respostas extras.\nconst conhecidos = ['nome', 'email', 'telefone', 'empresa', 'uf', 'mensagem', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term', 'gclid', 'website'];\nconst respostasExtras = {};\nif (texto(corpo.mensagem)) respostasExtras['Mensagem'] = texto(corpo.mensagem);\nfor (const campo of Object.keys(corpo)) {\n  if (!conhecidos.includes(campo) && texto(corpo[campo])) respostasExtras[campo] = texto(corpo[campo]);\n}\n\nconst utm = { source: texto(corpo.utm_source), medium: texto(corpo.utm_medium), campaign: texto(corpo.utm_campaign), content: texto(corpo.utm_content), term: texto(corpo.utm_term) };\nconst temUtm = Object.values(utm).some(function (valor) { return valor !== null; });\n\nreturn {\n  json: {\n    lead: {\n      origem: 'site',\n      idExterno: $json.idExterno,\n      recebidoEm: $now.toUTC().toISO(),\n      teste: false,\n      nome: texto(corpo.nome),\n      email: texto(corpo.email),\n      telefone: texto(corpo.telefone),\n      empresa: texto(corpo.empresa),\n      uf: texto(corpo.uf),\n      plataforma: 'site',\n      utm: temUtm ? utm : null,\n      gclid: texto(corpo.gclid),\n      respostasExtras: Object.keys(respostasExtras).length ? respostasExtras : null,\n    },\n  },\n};"
      }
    },
    {
      "id": "83b2e243-9a0e-4ad2-9b1e-0727c7f6721c",
      "name": "Responder ao site",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [1120, 160],
