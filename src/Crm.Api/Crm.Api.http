@host = http://localhost:5080

### Saúde da API e do banco
GET {{host}}/health

### Documento OpenAPI (só em desenvolvimento)
GET {{host}}/openapi/v1.json

# O cookie da sessão é Secure. Se o seu cliente HTTP não o reenviar em http://localhost, teste as rotas
# com sessão pelo Scalar (http://localhost:5080/scalar) ou pelo front.

### Login
# @prompt email
# @prompt senha
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "senha": "{{senha}}" }

### Usuário logado
GET {{host}}/api/auth/eu

### Troca de senha
# @prompt senhaAtual
# @prompt novaSenha
POST {{host}}/api/auth/trocar-senha
Content-Type: application/json

{ "senhaAtual": "{{senhaAtual}}", "novaSenha": "{{novaSenha}}" }

### Logout
POST {{host}}/api/auth/logout

### Usuários (admin)
GET {{host}}/api/usuarios

### Novo usuário (admin)
# @prompt senhaProvisoria
POST {{host}}/api/usuarios
Content-Type: application/json

{
  "nome": "Adriana",
  "email": "matheusbordinhao11+adriana@gmail.com",
  "perfil": "Atendente",
  "participaRodizio": true,
  "senhaProvisoria": "{{senhaProvisoria}}"
}

### Editar usuário (admin); "ativo": false desativa
# @prompt id
PUT {{host}}/api/usuarios/{{id}}
Content-Type: application/json

{
  "nome": "Adriana",
  "email": "matheusbordinhao11+adriana@gmail.com",
  "perfil": "Atendente",
  "ativo": true,
  "participaRodizio": true
}

### Redefinir a senha (admin)
# @prompt id
# @prompt senhaProvisoria
POST {{host}}/api/usuarios/{{id}}/redefinir-senha
Content-Type: application/json

{ "senhaProvisoria": "{{senhaProvisoria}}" }

### Leads (a atendente só vê os seus)
GET {{host}}/api/leads?busca=maria&ordem=Recentes&pagina=1&tamanho=25

### Ficha do lead, com os avisos
# @prompt id
GET {{host}}/api/leads/{{id}}

### Novo lead (a atendente fica com ele; o admin manda "responsavelId", ou null para o rodízio)
POST {{host}}/api/leads
Content-Type: application/json

{
  "nome": "João da Silva",
  "email": "matheusbordinhao11+joao@gmail.com",
  "telefone": "(51) 99999-8888",
  "cpfCnpj": "529.982.247-25",
  "uf": "RS",
  "empresa": null,
  "origem": "whatsapp",
  "responsavelId": null
}

### Passar o lead para outra pessoa (admin)
# @prompt id
# @prompt responsavelId
POST {{host}}/api/leads/{{id}}/responsavel
Content-Type: application/json

{ "responsavelId": "{{responsavelId}}" }

### Notificações do usuário logado (as 30 mais recentes e quantas não foram lidas)
GET {{host}}/api/notificacoes

### Marcar todas as notificações como lidas
POST {{host}}/api/notificacoes/lidas

### Configurações (admin)
GET {{host}}/api/configuracoes

### Ligar ou desligar o rodízio (admin); o PUT leva as duas configurações
PUT {{host}}/api/configuracoes
Content-Type: application/json

{ "exigirDocumentoParaGanho": true, "distribuicaoAutomatica": true }

### Etapas, para os filtros
GET {{host}}/api/etapas

### Campanhas, para os filtros
GET {{host}}/api/campanhas

# Importação de CSV (admin). O conteúdo vai em base64: o deste exemplo é uma planilha do Excel (Windows-1252 com
# ponto e vírgula) com o cabeçalho "Nome;E-mail;Celular" e uma linha, "Maria da Conceição". Para um arquivo seu:
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("docs\exemplos\leads-excel.csv"))
# Bash: base64 -w0 docs/exemplos/leads-excel.csv
@csv = Tm9tZTtFLW1haWw7Q2VsdWxhcg0KTWFyaWEgZGEgQ29uY2Vp5+NvO21hcmlhLmNvbmNlaWNhb0BleGFtcGxlLmNvbTsoNTEpIDk5OTk5LTAxMDENCg==

### Analisar o CSV: codificação, separador, prévia e sugestão de mapeamento, sem gravar nada (admin)
POST {{host}}/api/importacoes/analise
Content-Type: application/json

{ "nomeArquivo": "planilha.csv", "conteudoBase64": "{{csv}}" }

### Importar o CSV: responde 202, e as linhas são processadas em segundo plano (admin)
# Reimportar o mesmo arquivo responde "já importado" em todas as linhas, sem duplicar.
POST {{host}}/api/importacoes
Content-Type: application/json

{
  "nomeArquivo": "planilha.csv",
  "conteudoBase64": "{{csv}}",
  "campos": ["nome", "email", "telefone"],
  "colunaIdExterno": null,
  "origem": "planilha",
  "campanhaPadraoId": null,
  "novaCampanha": "Feira de Gramado",
  "responsavelId": null
}

### Andamento e resultado da importação (admin)
# @prompt id
GET {{host}}/api/importacoes/{{id}}

### Relatório de erros da importação, em CSV para o Excel (admin)
# @prompt id
GET {{host}}/api/importacoes/{{id}}/erros

### Lead pela integração, como o n8n envia (chave do Integracao__Chave, no .env)
# Reenviar a mesma requisição responde "ja_recebido". Troque o idExterno para simular um lead novo.
# @prompt chave
POST {{host}}/api/integracoes/leads
Content-Type: application/json
X-Api-Key: {{chave}}

{
  "origem": "meta_lead_ads",
  "idExterno": "1234567890123456",
  "recebidoEm": "2026-10-05T14:03:00Z",
  "teste": true,
  "nome": "Maria Souza",
  "email": "matheusbordinhao11+maria@gmail.com",
  "telefone": "(51) 9999-888",
  "cpfCnpj": null,
  "uf": "RS",
  "empresa": "Empresa X",
  "plataforma": "instagram",
  "campanha": { "id": "120210000000001", "nome": "Outubro | Serviço Y" },
  "conjunto": { "id": "120210000000002", "nome": "RS | 25-55" },
  "anuncio": { "id": "120210000000003", "nome": "Vídeo 1" },
  "formulario": { "id": "987654321", "nome": "Orçamento" },
  "utm": { "source": "instagram", "medium": "paid", "campaign": "outubro-servico-y", "content": null, "term": null },
  "gclid": null,
  "respostasExtras": { "Qual serviço você procura?": "Serviço Y" }
}

### Lead real pela integração: vai para o rodízio, aparece na hora no funil e no sino de quem o recebe e gera o alerta por e-mail (com o N8n__WebhookUrl)
# Cada envio é um lead novo: o idExterno e o e-mail mudam a cada vez.
# @prompt chave
POST {{host}}/api/integracoes/leads
Content-Type: application/json
X-Api-Key: {{chave}}

{
  "origem": "site",
  "idExterno": "{{$guid}}",
  "recebidoEm": "{{$datetime iso8601}}",
  "teste": false,
  "nome": "Joana Alves",
  "email": "joana.{{$guid}}@example.com",
  "telefone": null,
  "cpfCnpj": null,
  "uf": "RS",
  "empresa": "Empresa Y",
  "plataforma": "site",
  "campanha": { "id": "site-outubro", "nome": "Site | Outubro" },
  "conjunto": null,
  "anuncio": null,
  "formulario": null,
  "utm": null,
  "gclid": null,
  "respostasExtras": null
}
