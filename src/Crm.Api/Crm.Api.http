@host = http://localhost:5080

### Saúde da API e do banco
GET {{host}}/health

### Documento OpenAPI (só em desenvolvimento)
GET {{host}}/openapi/v1.json

# O cookie da sessão é Secure. Se o seu cliente HTTP não o reenviar em http://localhost, teste as rotas
# com sessão pelo Scalar (http://localhost:5080/scalar) ou pelo front.

### Login
# @prompt email
# @prompt senha
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "senha": "{{senha}}" }

### Usuário logado
GET {{host}}/api/auth/eu

### Troca de senha
# @prompt senhaAtual
# @prompt novaSenha
POST {{host}}/api/auth/trocar-senha
Content-Type: application/json

{ "senhaAtual": "{{senhaAtual}}", "novaSenha": "{{novaSenha}}" }

### Logout
POST {{host}}/api/auth/logout

### Usuários (admin)
GET {{host}}/api/usuarios

### Novo usuário (admin)
# @prompt senhaProvisoria
POST {{host}}/api/usuarios
Content-Type: application/json

{
  "nome": "Adriana",
  "email": "matheusbordinhao11+adriana@gmail.com",
  "perfil": "Atendente",
  "participaRodizio": true,
  "senhaProvisoria": "{{senhaProvisoria}}"
}

### Editar usuário (admin); "ativo": false desativa
# @prompt id
PUT {{host}}/api/usuarios/{{id}}
Content-Type: application/json

{
  "nome": "Adriana",
  "email": "matheusbordinhao11+adriana@gmail.com",
  "perfil": "Atendente",
  "ativo": true,
  "participaRodizio": true
}

### Redefinir a senha (admin)
# @prompt id
# @prompt senhaProvisoria
POST {{host}}/api/usuarios/{{id}}/redefinir-senha
Content-Type: application/json

{ "senhaProvisoria": "{{senhaProvisoria}}" }

### Leads (a atendente só vê os seus)
GET {{host}}/api/leads?busca=maria&ordem=Recentes&pagina=1&tamanho=25

### Ficha do lead, com os avisos
# @prompt id
GET {{host}}/api/leads/{{id}}

### Novo lead (a atendente fica com ele; o admin pode mandar "responsavelId")
POST {{host}}/api/leads
Content-Type: application/json

{
  "nome": "João da Silva",
  "email": "matheusbordinhao11+joao@gmail.com",
  "telefone": "(51) 99999-8888",
  "cpfCnpj": "529.982.247-25",
  "uf": "RS",
  "empresa": null,
  "origem": "whatsapp",
  "responsavelId": null
}

### Etapas, para os filtros
GET {{host}}/api/etapas

### Campanhas, para os filtros
GET {{host}}/api/campanhas

### Lead pela integração, como o n8n envia (chave do Integracao__Chave, no .env)
# Reenviar a mesma requisição responde "ja_recebido". Troque o idExterno para simular um lead novo.
# @prompt chave
POST {{host}}/api/integracoes/leads
Content-Type: application/json
X-Api-Key: {{chave}}

{
  "origem": "meta_lead_ads",
  "idExterno": "1234567890123456",
  "recebidoEm": "2026-10-05T14:03:00Z",
  "teste": true,
  "nome": "Maria Souza",
  "email": "matheusbordinhao11+maria@gmail.com",
  "telefone": "(51) 9999-888",
  "cpfCnpj": null,
  "uf": "RS",
  "empresa": "Empresa X",
  "plataforma": "instagram",
  "campanha": { "id": "120210000000001", "nome": "Outubro | Serviço Y" },
  "conjunto": { "id": "120210000000002", "nome": "RS | 25-55" },
  "anuncio": { "id": "120210000000003", "nome": "Vídeo 1" },
  "formulario": { "id": "987654321", "nome": "Orçamento" },
  "utm": { "source": "instagram", "medium": "paid", "campaign": "outubro-servico-y", "content": null, "term": null },
  "gclid": null,
  "respostasExtras": { "Qual serviço você procura?": "Serviço Y" }
}
